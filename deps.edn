{:mvn/repos
   {"my.datomic.com"      {:url "https://my.datomic.com/repo"}
    ;; for Datomic dev-local and REBL
    ;; Creds for this repo should be in ~/.m2/settings.xml
    "cognitect-dev-tools"
      {:url "https://dev-tools.cognitect.com/maven/releases/"}}

 :paths
   ["src/clj"
    "src/cljc"
    "resources"]

 :deps
   {aero/aero                                           {:mvn/version "1.1.6"}
    camel-snake-kebab/camel-snake-kebab                 {:mvn/version "0.4.2"}
    ch.qos.logback/logback-classic                      {:mvn/version "1.2.3"}
    clj-time/clj-time                                   #:mvn{:version "0.15.2"}
    clojure.java-time/clojure.java-time                 {:mvn/version "0.3.2"}
    com.cognitect/anomalies                             {:mvn/version "0.1.12"}
    ;; https://docs.datomic.com/on-prem/configuration/configuring-logging.html#logback
    com.datomic/datomic-pro
      {:mvn/version "1.0.6269"
       :exclusions  [org.slf4j/slf4j-nop
                     org.slf4j/slf4j-log4j12]}
    com.datomic/dev-local                               {:mvn/version "0.9.225"}
    com.walmartlabs/lacinia                             #:mvn{:version "0.38.0"}
    integrant/integrant                                 #:mvn{:version "0.8.0"}
    ;; TODO move this to :alias.dev/extra-deps
    integrant/repl                                      #:mvn{:version "0.3.2"}
    io.aviso/logging                                    #:mvn{:version "0.3.2"}
    me.gosimple/nbvcxz                                  {:mvn/version "1.5.0"}
    ;; TODO may need to hand pick https://github.com/metosin/reitit#main-modules
    metosin/reitit                                      #:mvn{:version "0.5.13"}
    metosin/ring-http-response                          {:mvn/version "0.9.2"}
    ;; Reguired by spring-security-crypto
    org.bouncycastle/bcpkix-jdk15on                     {:mvn/version "1.65"}
    org.clojure/clojure                                 #:mvn{:version "1.10.3"}
    org.clojure/tools.cli                               {:mvn/version "1.0.206"}
    org.clojure/tools.logging                           {:mvn/version "1.1.0"}
    org.clojure/tools.namespace                         {:mvn/version "1.1.0"}
    org.springframework.security/spring-security-crypto {:mvn/version
                                                           "5.3.2.RELEASE"}
    ovotech/ring-jwt                                    {:mvn/version "2.2.1"}
    ring/ring-core                                      {:mvn/version "1.9.2"}
    ring-cors/ring-cors                                 {:mvn/version "0.1.13"}
    ring/ring-defaults                                  {:mvn/version "0.3.2"}
    ring/ring-json                                      {:mvn/version "0.5.1"}
    ring/ring-jetty-adapter                             {:mvn/version "1.9.2"}
    ring-basic-authentication/ring-basic-authentication {:mvn/version "1.1.0"}
    ring-webjars/ring-webjars                           {:mvn/version "0.2.0"}
    threatgrid/ring-graphql-ui                          {:mvn/version "0.1.3"}}

 :aliases
   {:env/cljs
      {:extra-paths ["src/cljs"
                     "src/js"
                     "test/cljs"]

       :extra-deps
         {thheller/shadow-cljs {:mvn/version "2.16.4"}

          herb/herb            {:mvn/version "0.10.0"}
          re-frame/re-frame    {:mvn/version "1.2.0"}
          reagent/reagent      {:mvn/version "1.1.0"}
          bidi/bidi            {:mvn/version "2.1.6"}
          clj-commons/pushy    {:mvn/version "0.3.10"}

          ;; TODO move these dev dependencies
          binaryage/devtools   {:mvn/version "1.0.4"}
          cider/cider-nrepl    {:mvn/version "0.27.2"}

          re-graph/re-graph
            {:mvn/version "0.1.16"
             :exclusions
               [re-graph.hato/re-graph.hato
                re-graph.clj-http-gniazdo/re-graph.clj-http-gniazdo]}}}

    :env/dev
      {:extra-paths ["env/dev/clj" "env/dev/resources"]
       :extra-deps  {ring/ring-devel {:mvn/version "1.9.2"}}}

    :env/test
      {:extra-paths ["test/clj" "env/test/resources"]
       :extra-deps  {buddy/buddy-core       {:mvn/version "1.10.1"}
                     org.clojure/test.check {:mvn/version "1.1.0"}
                     ring/ring-mock         {:mvn/version "0.4.0"}}}

    :build
      {:deps       {io.github.clojure/tools.build {:git/tag "v0.6.2"
                                                   :git/sha "226fb52"}}
       :ns-default build}

    :start-api
      {:main-opts ["-m" "cfapp.api.core" "--dev"]}

    :test
      {:extra-deps {com.cognitect/test-runner
                      {:git/url "https://github.com/cognitect-labs/test-runner"
                       :sha     "b6b3193fcc42659d7e46ecd1884a228993441182"}}
       :main-opts  ["-m" "cognitect.test-runner"]}}}
