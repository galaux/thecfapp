#!/usr/bin/env bash

# This file is picked up by the Heroku Clojure Build Pack to override its
# default behavior to use Leiningen.

 # This script assumes the mobile app is built and the resulting static assets
 # are available in `./resources/public`.

# Exit if any command fails
set -e

# Show debug
set -x

# On Heroku, this requires setting the CLOJURE_CLI_VERSION environment variable
# for the Clojure build pack to pick it up.
clojure -T:build uber
