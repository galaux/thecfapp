{; `:source-paths` and `:dependencies` declared in `deps.edn`
 :deps {:aliases [:env/cljs]}

 :nrepl        {:port 8777}

 :jvm-opts     ["-Xmx1G"]

 :dev-http
   {8280 ["resources/public"]
    8290 "target/browser-test"}

 :builds
   {:mobile
      {:target     :browser
       :output-dir "resources/public/js/compiled"
       :asset-path "/js/compiled"
       :modules
         {:mobile {:init-fn cfapp.mobile.core/init}}
       :devtools
         {:preloads []}
       :dev
         {:compiler-options
            {:closure-defines
               {}}}}

    :stories
      {:target     :npm-module
       :ns-regexp  "^cfapp.mobile.ui.*.story$"
       :output-dir "resources/public/js/stories"}

    :browser-test
      {:target    :browser-test
       :ns-regexp "-test$"
       :runner-ns shadow.test.browser
       :test-dir  "target/browser-test"}

    :karma-test
      {:target    :karma
       :ns-regexp "-test$"
       :output-to "target/karma-test.js"}}}
