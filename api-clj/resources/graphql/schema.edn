{:scalars
 {:Date
  {:parse :parse-date
   :serialize :serialize-date}
  :ID
  {:parse :parse-uuid
   :serialize :serialize-uuid}}

 :enums
 {:ScoringType
  {:description "The dimension used to evaluate a workout"
   :values [:DURATION_MS :REPETITIONS]}}

 :input-objects
 {:AddUserToCommunityInput
  {:fields {:userId {:type (non-null :ID)}
            :communityId {:type (non-null :ID)}}}
  :CreateUserInput
  {:fields {:screenName {:type (non-null String)}
            :email {:type (non-null String)}}}
  :NewCommunityInput
  {:fields {:name {:type (non-null String)}
            :street {:type String}
            :zipCode {:type String}
            :city {:type String}
            :country {:type String}}}
  :NewScoreInput
  {:fields {:userId {:type (non-null :ID)}
            :value {:type (non-null Int)}
            :wodId {:type (non-null :ID)}}}
  :RemoveUserFromCommunityInput
  {:fields {:userId {:type (non-null :ID)}
            :communityId {:type (non-null :ID)}}}}

 :objects
 {:Address
  {:fields {:street {:type String}
            :zipCode {:type String}
            :city {:type String}
            :country {:type String}}}

  :Community
  {:fields {:id {:type (non-null :ID)}
            :name {:type (non-null String)}
            :address {:type :Address}
            :memberCount {:type (non-null Int)
                          :resolve :Community/member-count}
            :wods {:type (list :Wod)
                   :resolve :Community/wods}}}

  :User
  {:fields {:id {:type (non-null :ID)}
            :name {:type (non-null String)}
            :email {:type String}
            :communities {:type (non-null (list :Community))
                          :resolve :User/communities}}}

  :Wod
  {:fields {:id {:type (non-null :ID)}
            :date {:type (non-null :Date)}
            :community {:type (non-null :Community)
                        :resolve :Wod/community}
            :workout {:type (non-null :Workout)
                      :resolve :Wod/workout}
            :scores {:type (list :Score)
                     :resolve :Wod/scores}}}

  :Workout
  {:fields {:id {:type (non-null :ID)}
            :name {:type (non-null String)}
            :description {:type String}
            :scoringType {:type :ScoringType}}}

  :Score
  {:fields {:id {:type (non-null :ID)}
            :user {:type (non-null :User)
                   :resolve :Score/user}
            :wod {:type (non-null :Wod)
                  :resolve :Score/wod}
            :value {:type (non-null Int)}}}}

 :queries
 {:communities {:description "Not used by mobile"
                :type (non-null (list :Community))
                :resolve :Query/list-communities}
  :community {:type :Community
              :args {:id {:type (non-null :ID)}}
              :resolve :Query/get-community}
  :findCommunities {:args {:name {:type (non-null :String)}}
                    :type (non-null (list :Community))
                    :resolve :Query/find-communities}

  :users {:description "Not used by mobile"
          :type (non-null (list :User))
          :resolve :Query/list-users}
  :user {:type :User
         :args {:id {:type (non-null :ID)}}
         :resolve :Query/get-user}
  :userCommunities {:args {:userId {:type (non-null :ID)}}
                    :type (list :Community)
                    :resolve :Query/user-communities}
  :userWods {:type (list :Wod) ;; FIXME non-null on list and/or :Wod?
             :args {:userId {:type (non-null :ID)}}
             :resolve :Query/user-wods}
  :userWorkouts {:description "Not used by mobile"
                 :args {:id {:type (non-null :ID)}}
                 :type (list :Workout)
                 :resolve :Query/user-workouts}

  :wod {:args {:id {:type (non-null :ID)}}
        :type :Wod
        :resolve :Query/get-wod}
  :workouts {:type (non-null (list :Workout))
             :resolve :Query/list-workouts}}

 :mutations
 {:createCommunity {:args {:creatorId {:type (non-null :ID)}
                           :input {:type (non-null :NewCommunityInput)}}
                    :type :Community
                    :resolve :Mutation/new-community}
  :createScore {:args {:input {:type (non-null :NewScoreInput)}}
                :type :Score
                :resolve :Mutation/new-score}
  :createUser {:description "Not used by mobile"
               :args {:input {:type (non-null :CreateUserInput)}}
               :type :User
               :resolve :Mutation/new-user}
  :addUserToCommunity {:args {:input {:type (non-null :AddUserToCommunityInput)}}
                       :type :Community
                       :resolve :Mutation/join-community}
  :removeUserFromCommunity {:args {:input {:type (non-null :RemoveUserFromCommunityInput)}}
                            :type (non-null :ID)
                            :resolve :Mutation/leave-community}}}
