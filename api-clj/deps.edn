{:mvn/repos
 {"my.datomic.com" {:url "https://my.datomic.com/repo"}
  ;; for Datomic dev-local and REBL
  ;; Creds for this repo should be in ~/.m2/settings.xml
  "cognitect-dev-tools" {:url "https://dev-tools.cognitect.com/maven/releases/"}}

 :paths
 ["src" "resources"]

 :deps
 {aero/aero {:mvn/version "1.1.6"}
  camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.2"}
  ch.qos.logback/logback-classic {:mvn/version "1.2.3"}
  clj-time/clj-time #:mvn{:version "0.15.2"}
  clojure.java-time/clojure.java-time {:mvn/version "0.3.2"}
  com.cognitect/anomalies {:mvn/version "0.1.12"}
  com.datomic/datomic-pro {:mvn/version "1.0.6269"}
  com.datomic/dev-local {:mvn/version "0.9.225"}
  ;; TODO Exclusion [org.slf4j/log4j-over-slf4j org.slf4j/slf4j-nop com.google.guava/guava]
  com.walmartlabs/lacinia #:mvn{:version "0.38.0"}
  integrant/integrant #:mvn{:version "0.8.0"}
  integrant/repl #:mvn{:version "0.3.2"} ;; TODO move this to :alias.dev/extra-deps
  io.aviso/logging #:mvn{:version "0.3.2"}
  ;; TODO may need to hand pick https://github.com/metosin/reitit#main-modules
  metosin/reitit #:mvn{:version "0.5.13"}
  metosin/ring-http-response {:mvn/version "0.9.2"}
  org.clojure/clojure #:mvn{:version "1.10.3"}
  org.clojure/tools.cli {:mvn/version "1.0.206"}
  org.clojure/tools.logging {:mvn/version "1.1.0"}
  org.clojure/tools.namespace {:mvn/version "1.1.0"}
  ring/ring-core {:mvn/version "1.9.2"}
  ring/ring-defaults {:mvn/version "0.3.2"}
  ring/ring-jetty-adapter {:mvn/version "1.9.2"}
  tupelo/tupelo {:mvn/version "21.04.13"}}

 :aliases
 ;; TODO `:dev` should not have "test" but we should have a proper "project/test"
 {:dev {:extra-paths ["dev" "dev-resources" "test"]
        :extra-deps {ring/ring-devel {:mvn/version "1.9.2"}}}
  ;; :test requires "dev-resources" because this is where test-utils is located ;; ← old comment
  :test {:extra-paths ["test" "dev-resources"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.0"}
                      ring/ring-mock {:mvn/version "0.4.0"}}}

  :runner {:extra-deps {com.cognitect/test-runner
                        {:git/url "https://github.com/cognitect-labs/test-runner"
                         :sha "b6b3193fcc42659d7e46ecd1884a228993441182"}}
           :main-opts ["-m" "cognitect.test-runner"
                       "-d" "test"]}}}
