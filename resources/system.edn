;; Very nice article on how to use config with Integrant
;; https://www.karimarttila.fi/clojure/2020/09/07/clojure-integrant-exercise.html
;; TODO Rename the `:prod` profile in `:live`
;; TODO rework config: access keys through functions
;; https://github.com/juxt/aero#use-functions-to-wrap-access-to-your-configuration
{:cfapp.api/handler
   {:conn #ig/ref :cfapp.api.db/conn
    :execute-query #ig/ref :cfapp.api.graphql/execute-query
    :serve-mobile #profile
                   {:dev  false
                    :test false
                    :prod true}

    :server-url
      #profile
       {:dev  nil
        :test nil
        :prod #envf ["https://%s.herokuapp.com" HEROKU_APP_NAME]}

    :jwt-conf
      #profile
       {:dev  {:domain                "cfapp-dev.eu.auth0.com"
               :client-id             "V8B2VcnW1Jk0FJXUs5uVk7yqp4z4G2qB"
               :issuers
                 {"https://cfapp-dev.eu.auth0.com/"
                    {:alg          :RS256
                     :jwk-endpoint
                       "https://cfapp-dev.eu.auth0.com/.well-known/jwks.json"}}
               :reject-missing-token? false}
        :test {:domain                "cfapp.eu.auth0.com"
               :client-id             "Uwq04GxM1iw3F2NjAtcQchGeJ2t3lhnb"
               :issuers
                 {"https://cfapp.eu.auth0.com/"
                    {:alg          :RS256
                     :jwk-endpoint
                       "https://cfapp.eu.auth0.com/.well-known/jwks.json"}}
               :reject-missing-token? false}
        :prod
          {:domain                #env JWT_DOMAIN
           :client-id             #env JWT_CLIENT_ID
           :issuers               {#envf ["https://%s/" JWT_DOMAIN]
                                     {:alg          :RS256
                                      :jwk-endpoint
                                        #envf
                                         ["https://%s/.well-known/jwks.json"
                                          JWT_DOMAIN]}}
           :reject-missing-token? false}}
    :password-encoder #ig/ref :cfapp.api.auth/password-encoder
    :password-strength-checker #ig/ref :cfapp.api.auth/password-strength-checker
    :static-auth #profile
                  {:dev {;; FIXME read these from a local .secret file
                         ;; and also remove them from `app.json` (they
                         ;; should be provided in the Heroku UI)
                         :id       "cfapp_dev"
                         :password
                           "lUW1EYNnN4d8R7IvAiQ5W3Yrt6f2NRlPqTm9P3EDJbZTke9lVc"}
                   :test {:id       "good"
                          :password "creds"}
                   :prod {:id       #env STATIC_AUTH_ID
                          :password #env STATIC_AUTH_PASSWORD}}}

 :cfapp.api/http-server
   {:handler #ig/ref :cfapp.api/handler
    ; Heroku expects application to bind on `PORT`
    :port    #long #or [#env PORT 4000]}

 :cfapp.api.auth/password-encoder
   {}

 :cfapp.api.auth/password-strength-checker
   {}

 :cfapp.api.db/client
   {:server-type :dev-local
    :system      #profile
                  {:dev  "cfapp-dev"
                   :test "cfapp-test"
                   :prod "cfapp-prod"}
    :storage-dir #profile
                  {:dev  #envf ["%s/.datomic" HOME]
                   :test :mem
                   :prod #envf ["%s/.datomic" HOME]}}

 :cfapp.api.db/conn
   {:bootstrap-if-empty? #profile
                          {:dev  true
                           :test false
                           :prod true}
    :client              #ig/ref :cfapp.api.db/client
    :db-name             "domain"}

 :cfapp.api.graphql/schema
   {}

 :cfapp.api.graphql/execute-query
   {:conn   #ig/ref :cfapp.api.db/conn
    :schema #ig/ref :cfapp.api.graphql/schema}}
