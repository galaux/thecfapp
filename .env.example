# Enable GraphQL introspection (required for Playground)
APOLLO_INTROSPECTION=true

# Enable Apollo Playground, the graphical GraphQL query editor
APOLLO_PLAYGROUND=true

# DB configuration
DATABASE_URL=postgres://postgres:@localhost:5432/thecfapp
# Should the application create the DB and update its structure
# to match the ORM entities at startup
DATABASE_SYNCHRONIZE=true
# Verbose ORM logging
DATABASE_LOGGING=false

# Should the static front-end application files be served (default: true)
#SERVE_FRONT_END=false

PORT=4000
