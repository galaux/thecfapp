{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "build/index.js",
  "scripts": {
    "build": "yarn codegen && tsc",
    "codegen": "graphql-codegen --config codegen.yml",
    "db:schema": "ts-node ./node_modules/typeorm/cli.js",
    "db:schema:drop": "yarn db:schema schema:drop",
    "db:schema:log": "yarn db:schema schema:log",
    "db:schema:sync": "yarn db:schema schema:sync",
    "db:seed": "ts-node ./node_modules/typeorm-seeding/dist/cli.js",
    "db:seed:config": "yarn db:seed config",
    "db:seed:run": "yarn db:seed seed",
    "dev": "yarn build && node --require dotenv/config build/index.js",
    "start": "node build/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TheCFApp/thecfapp.git"
  },
  "contributors": [
    {
      "name": "Guillaume Alaux",
      "email": "guillaume@alaux.net"
    },
    {
      "name": "Ugo Onali",
      "email": "hello@onali-ugo.fr"
    }
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TheCFApp/thecfapp/issues"
  },
  "homepage": "https://github.com/TheCFApp/thecfapp#readme",
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "devDependencies": {
    "@graphql-codegen/cli": "1.16.1",
    "@graphql-codegen/introspection": "1.16.1",
    "@graphql-codegen/typescript": "1.16.1",
    "@graphql-codegen/typescript-resolvers": "1.16.1",
    "@types/faker": "^4.1.12",
    "@types/graphql": "^14.5.0",
    "@types/node": "^14.0.14",
    "@types/uuid": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^3.5.0",
    "@typescript-eslint/parser": "^3.5.0",
    "dotenv": "^8.2.0",
    "eslint": "^7.4.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-sort-imports-es6-autofix": "^0.5.0",
    "husky": "^4.2.5",
    "nodemon": "^2.0.4",
    "prettier": "^2.0.5",
    "pretty-quick": "^2.0.1",
    "ts-node": "^8.10.2",
    "typescript": "^3.9.6"
  },
  "dependencies": {
    "@js-joda/core": "^3.0.0",
    "apollo-server": "^2.15.1",
    "apollo-server-express": "^2.16.0",
    "graphql": "^15.2.0",
    "graphql-joda-types": "^2.1.2",
    "graphql-voyager": "^1.0.0-rc.31",
    "pg": "^8.2.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.2.25",
    "typeorm-seeding": "^1.6.1",
    "uuid": "^8.2.0"
  }
}
