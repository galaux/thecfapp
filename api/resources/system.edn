;; Very nice article on how to use config with Integrant
;; https://www.karimarttila.fi/clojure/2020/09/07/clojure-integrant-exercise.html
{:thecfapp/handler
 {:execute-query #ig/ref :thecfapp.graphql/execute-query}

 :thecfapp/http-server
 {:handler #ig/ref :thecfapp/handler
  :port #long #or [#env HTTP_PORT 4000]}

 :thecfapp.db/client
 {:server-type :dev-local
  :system #profile {:dev "cfapp-dev"
                    :test "cfapp-test"
                    :prod "cfapp-prod"}
  :storage-dir #profile {:dev "/enc/home/miguel/TheCFApp/sources/thecfapp/api/datomic"
                         :test :mem
                         :prod "/enc/home/miguel/TheCFApp/sources/thecfapp/api/datomic"}}

 :thecfapp.db/conn
 {:client #ig/ref :thecfapp.db/client
  :db-name "domain"}

 :thecfapp.graphql/compiled-schema
 {}

 :thecfapp.graphql/execute-query
 {:conn #ig/ref :thecfapp.db/conn
  :schema #ig/ref :thecfapp.graphql/compiled-schema}}
