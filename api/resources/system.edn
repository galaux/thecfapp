;; Very nice article on how to use config with Integrant
;; https://www.karimarttila.fi/clojure/2020/09/07/clojure-integrant-exercise.html
{:cfapp.api/handler
 {:execute-query #ig/ref :cfapp.api.graphql/execute-query}

 :cfapp.api/http-server
 {:handler #ig/ref :cfapp.api/handler
  ; Heroku expects application to bind on `PORT`
  :port #long #or [#env PORT 4000]}

 :cfapp.api.db/client
 {:server-type :dev-local
  :system #profile {:dev "cfapp-dev"
                    :test "cfapp-test"
                    :prod "cfapp-prod"}
  :storage-dir #profile {:dev "/enc/home/miguel/TheCFApp/sources/thecfapp/api/datomic"
                         :test :mem
                         :prod #join [#env HOME "/datomic"]}}

 :cfapp.api.db/conn
 {:bootstrap-if-empty? #profile {:dev true
                                 :test false
                                 :prod true}
  :client #ig/ref :cfapp.api.db/client
  :db-name "domain"}

 :cfapp.api.graphql/compiled-schema
 {}

 :cfapp.api.graphql/execute-query
 {:conn #ig/ref :cfapp.api.db/conn
  :schema #ig/ref :cfapp.api.graphql/compiled-schema}}
