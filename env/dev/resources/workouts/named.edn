;; NOTE: unless otherwise stated, all durations are in milliseconds
;; NOTE: I should not try to handle multiple weight units in the DB. Let's
;; use Kg then let the UI use a hard coded conversion table (to avoid weird
;; roundings)
;; :unit/calorie
;; :unit/meter
;; :unit/body-weight ;; Not yet
;; :unit/kilogram    ;; Not yet either as we don't introduce body-weight
;; :unit/millisecond ;; Not yet either as we don't introduce body-weight

;; Pounds → Kilogram
;; 225 - 102
;; 155 - 70
;; 135 - 61
;; 95 - 43
;; 65 - 30
;; 45 - 20
;; 35 - 16
;; Pood → Kilogram
;; 2 - 32
;; 1.5 - 24
;; 1 - 16

[{:db/id        "angie"
  :workout/id   #rand-id nil
  :workout/name "Angie"
  ;; For Time
  ;; 100 Pull-Ups
  ;; 100 Push-Ups
  ;; 100 Sit-Ups
  ;; 100 Air Squats
  :workout/loop
  {:workout.loop/score-type :score-type/duration
   :workout.loop/tasks
   [{:exercise/movement  {:movement/name "Pull-Up"}
     :exercise/rep-count 100}
    {:exercise/movement  {:movement/name "Push-Up"}
     :exercise/rep-count 100}
    {:exercise/movement  {:movement/name "Sit-Up"}
     :exercise/rep-count 100}
    {:exercise/movement  {:movement/name "Air Squat"}
     :exercise/rep-count 100}]}}

