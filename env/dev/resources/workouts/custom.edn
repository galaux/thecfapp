 {:db/id        "dansaert 2022-05-31"
  :workout/name "dansaert 2022-05-31"
  :workout/id   #rand-id nil
  ;; 2 rounds for time
  ;;   3 rounds
  ;;     6 single dumbell clean & jerk (20Kg/15Kg)
  ;;     6 handstand push-ups
  ;;   1' rest
  ;;   3 rounds
  ;;     6 double dumbell clean & jerk (20Kg/15Kg)
  ;;     6 handstand walk 8m
  ;;   1' rest
  :workout/loop
  {:workout.loop/round-count 2
   :workout.loop/score-type  :score-type/duration
   :workout.loop/tasks
   [{:workout.loop/round-count 3
     :workout.loop/tasks
     [{:exercise/movement    {:movement/name "Single Dumbell Clean & Jerk"}
       :exercise/application
       {:exercise.application/value
        {:exercise.application.value/men   20.0
         :exercise.application.value/women 15.0}
        :exercise.application/unit  :unit/kilogram}
       :exercise/rep-count   6}
      {:exercise/movement  {:movement/name "Handstand Push-Up"}
       :exercise/rep-count 6}]}
    {:exercise/movement    {:movement/name "Rest"}
     :exercise/application
     {:exercise.application/value
      {:exercise.application.value/all 60000.0}
      :exercise.application/unit  :unit/millisecond}}
    {:workout.loop/round-count 3
     :workout.loop/tasks
     [{:exercise/movement    {:movement/name "Double Dumbell Clean & Jerk"}
       :exercise/application
       {:exercise.application/value
        {:exercise.application.value/men   20.0
         :exercise.application.value/women 15.0}
        :exercise.application/unit  :unit/kilogram}
       :exercise/rep-count   6}
      {:exercise/movement    {:movement/name "Handstand Walk"}
       :exercise/application
       {:exercise.application/value {:exercise.application.value/all 8.0}
        :exercise.application/unit  :unit/meter}}]}
    {:exercise/movement    {:movement/name "Rest"}
     :exercise/application
     {:exercise.application/value
      {:exercise.application.value/all 60000.0}
      :exercise.application/unit  :unit/millisecond}}]}}

