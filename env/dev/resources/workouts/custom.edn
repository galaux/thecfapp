 {:db/id        "dansaert 23-05-2022"
  :workout/id   #rand-id nil
  :workout/name        "dansaert 23-05-2022"
  ;; 3 Rounds For Time – cap time 10'
  ;; 12 pistols
  ;; 24 Russian kettlebell swings (24Kg)
  ;; 48 DU
  :workout/loop
  {:workout.loop/score-type :score-type/duration
   :workout.loop/tasks
   [{:exercise/movement  {:movement/name "Pistol"}
     :exercise/rep-count 12}
    {:exercise/movement    {:movement/name "Russian Kettlebell Swing"}
     :exercise/application
     {:exercise.application/value
      {:exercise.application.value/men   24.0
       :exercise.application.value/women 16.0}
      :exercise.application/unit  :unit/kilogram}
     :exercise/rep-count   24}
    {:exercise/movement  {:movement/name "Double-Under"}
     :exercise/rep-count 48}]}}

