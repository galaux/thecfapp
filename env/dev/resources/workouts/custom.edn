 {:db/id        "dansaert 2022-06-11"
  ;; Team Wod
  ;; For time (cap time 12')
  ;; 15-12-9
  ;;   wall-climb (share)
  ;;   devil press (synchro) (30Kg/22.5Kg)
  ;; 2' rest
  ;; 2Km row to share however you want
  :workout/id   #rand-id nil
  :workout/name "dansaert 2022-06-11"
  :workout/loop
  {:workout.loop/score-type :score-type/duration
   :workout.loop/cap-time 720000
   :workout.loop/tasks
   [{:exercise/movement {:movement/name "Wall Climb"} :exercise/rep-count 15}
    {:exercise/movement    {:movement/name "Devil Press"}
     :exercise/application {:exercise.application/value
                            {:exercise.application.value/men   30.0
                             :exercise.application.value/women 22.5}
                            :exercise.application/unit :unit/kilogram}
     :exercise/rep-count   15}
    {:exercise/movement {:movement/name "Wall Climb"} :exercise/rep-count 12}
    {:exercise/movement    {:movement/name "Devil Press"}
     :exercise/application {:exercise.application/value
                            {:exercise.application.value/men   30.0
                             :exercise.application.value/women 22.5}
                            :exercise.application/unit :unit/kilogram}
     :exercise/rep-count   12}
    {:exercise/movement {:movement/name "Wall Climb"} :exercise/rep-count 9}
    {:exercise/movement    {:movement/name "Devil Press"}
     :exercise/application {:exercise.application/value
                            {:exercise.application.value/men   30.0
                             :exercise.application.value/women 22.5}
                            :exercise.application/unit :unit/kilogram}
     :exercise/rep-count   9}
    {:exercise/movement    {:movement/name "Rest"}
     :exercise/application {:exercise.application.value/all 120000.0}}
    {:exercise/movement    {:movement/name "Row"}
     :exercise/application {:exercise.application/value
                            {:exercise.application.value/all 2000.0}
                            :exercise.application/unit :unit/meter}}]}}]
