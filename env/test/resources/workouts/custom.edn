 :dansaert-2022-06-11
 {:str "For time, time cap 12'\n\n15-12-9 for time\nWall Climb\nDevil Press @30Kg/22.5Kg\n\n2' Rest\n2000m Row"
  :db
  {:workout/loop
   {:workout.loop/score-type :score-type/duration
    :workout.loop/time-cap 720000
    :workout.loop/tasks
    [{:workout.loop/rep-scheme
      {:workout.loop.rep-scheme/first-rep-count 15
       :workout.loop.rep-scheme/last-rep-count 9
       :workout.loop.rep-scheme/step -3}
      :workout.loop/tasks
      [{:exercise/movement {:db/id :wall-climb
                            :movement/name "Wall Climb"}}
       {:exercise/movement    {:db/id :devil-press
                               :movement/name "Devil Press"}
        :exercise/application {:exercise.application/value
                               {:exercise.application.value/men   30.0
                                :exercise.application.value/women 22.5}
                               :exercise.application/unit :unit/kilogram}}]}
     {:exercise/movement    {:db/id :rest
                             :movement/name "Rest"}
      :exercise/application {:exercise.application/value {:exercise.application.value/all 120000.0}
                             :exercise.application/unit :unit/millisecond}}
     {:exercise/movement    {:db/id :row
                             :movement/name "Row"}
      :exercise/application {:exercise.application/value
                             {:exercise.application.value/all 2000.0}
                             :exercise.application/unit :unit/meter}}]}}}}
