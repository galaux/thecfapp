        :exercise/rep-count   20}
       {:exercise/movement  {:movement/id :movement.id/double-under}
        :exercise/rep-count 40}]}
     {:exercise/movement    {:movement/id :movement.id/rest}
      :exercise/application
      {:exercise.application/value
       {:exercise.application.value/all 60000.0}
       :exercise.application/unit  :unit/millisecond}}
     {:workout.loop/duration 300000
      :workout.loop/tasks
      [{:exercise/movement    {:movement/id
                               :movement.id/double-kettlebell-clean}
        :exercise/application
        {:exercise.application/value
         {:exercise.application.value/men   20.0
          :exercise.application.value/women 16.0}
         :exercise.application/unit  :unit/kilogram}
        :exercise/rep-count   20}
       {:exercise/movement  {:movement/id :movement.id/double-under}
        :exercise/rep-count 40}]}
     {:exercise/movement    {:movement/id :movement.id/rest}
      :exercise/application
      {:exercise.application/value
       {:exercise.application.value/all 60000.0}
       :exercise.application/unit  :unit/millisecond}}
     {:workout.loop/duration 300000
      :workout.loop/tasks
      [{:exercise/movement    {:movement/id
                               :movement.id/double-kettlebell-thruster}
        :exercise/application
        {:exercise.application/value
         {:exercise.application.value/men   20.0
          :exercise.application.value/women 16.0}
         :exercise.application/unit  :unit/kilogram}
        :exercise/rep-count   20}
       {:exercise/movement  {:movement/id :movement.id/double-under}
        :exercise/rep-count 40}]}]}}}

