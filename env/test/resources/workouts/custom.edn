{:dansaert-multi-amrap
 {:str
  "\"Dansaert multi-AMRAP\"\n\nAMRAP 5'\n20 Double Kettlebell Squat @20Kg/16kg\n40 Double-Under\n\n1' Rest\n\nAMRAP 5'\n20 Double Kettlebell Clean @20Kg/16Kg\n40 Double-Under\n\n1' Rest\n\nAMRAP 5'\n20 Double Kettlebell Thruster @20Kg/16Kg\n40 Double-Under"
  :db
  {:workout/name "Dansaert multi-AMRAP"
   :workout/loop
   {;:workout.loop/score-type :score-type/rep-count
    :workout.loop/tasks
