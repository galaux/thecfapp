 :dansaert-multi-amrap
 {:str "\"Dansaert multi-AMRAP\"\n\nAMRAP 5'\n20 Double Kettlebell Squat @20Kg/16kg\n40 Double-Under\n\n1' Rest\n\nAMRAP 5'\n20 Double Kettlebell Clean @20Kg/16Kg\n40 Double-Under\n\n1' Rest\n\nAMRAP 5'\n20 Double Kettlebell Thruster @20Kg/16Kg\n40 Double-Under"
  :db
  {:workout/name "Dansaert multi-AMRAP"
   :workout/loop
   {;:workout.loop/score-type :score-type/rep-count
    :workout.loop/tasks
    [{:workout.loop/duration 300000
      :workout.loop/tasks
      [{:exercise/movement    {:db/id :double-kb-squat
                               :movement/name "Double Kettlebell Squat"}
        :exercise/application
        {:exercise.application/value
         {:exercise.application.value/men   20.0
          :exercise.application.value/women 16.0}
         :exercise.application/unit  :unit/kilogram}
        :exercise/rep-count   20}
       {:exercise/movement  {:db/id :double-under
                             :movement/name "Double Under"}
        :exercise/rep-count 40}]}
     {:exercise/movement    {:db/id :rest
                             :movement/name "Rest"}
      :exercise/application
      {:exercise.application/value
       {:exercise.application.value/all 60000.0}
       :exercise.application/unit  :unit/millisecond}}
     {:workout.loop/duration 300000
      :workout.loop/tasks
      [{:exercise/movement    {:db/id :double-kb-clean
                               :movement/name "Double Kettlebell Clean"}
        :exercise/application
        {:exercise.application/value
         {:exercise.application.value/men   20.0
          :exercise.application.value/women 16.0}
         :exercise.application/unit  :unit/kilogram}
        :exercise/rep-count   20}
       {:exercise/movement  {:db/id :double-under
                             :movement/name "Double Under"}
        :exercise/rep-count 40}]}
     {:exercise/movement    {:db/id :rest :movement/name "Rest"}
      :exercise/application
      {:exercise.application/value
       {:exercise.application.value/all 60000.0}
       :exercise.application/unit  :unit/millisecond}}
     {:workout.loop/duration 300000
      :workout.loop/tasks
      [{:exercise/movement    {:db/id :double-kb-thruster
                               :movement/name "Double Kettlebell Thruster"}
        :exercise/application
        {:exercise.application/value
         {:exercise.application.value/men   20.0
          :exercise.application.value/women 16.0}
         :exercise.application/unit  :unit/kilogram}
        :exercise/rep-count   20}
       {:exercise/movement  {:db/id :double-under
                             :movement/name "Double Under"}
        :exercise/rep-count 40}]}]}}}

 :dansaert-2022-05-31
 {:str "2 rounds for time\n\n3 rounds for time\n6 Single arm dumbbell Clean & Jerk @20Kg/15Kg\n6 Handstand Push-Up\n\n1' Rest\n\n3 rounds for time\n6 Double dumbbell Clean & Jerk @20Kg/15Kg\n6 Handstand Walk (8m)\n\n1' Rest\n"
  :db
  {:workout/loop
   {:workout.loop/round-count 2
    :workout.loop/score-type  :score-type/duration
    :workout.loop/tasks
    [{:workout.loop/round-count 3
      :workout.loop/tasks
      [{:exercise/movement    {:db/id :single-arm-db-clean-and-jerk
                               :movement/name "Dumbbell Clean & Jerk"}
        :exercise/application
        {:exercise.application/value
         {:exercise.application.value/men   20.0
          :exercise.application.value/women 15.0}
         :exercise.application/unit  :unit/kilogram}
        :exercise/rep-count   6}
       {:exercise/movement  {:db/id :hspu
                             :movement/name "Handstand Push-up"}
        :exercise/rep-count 6}]}
     {:exercise/movement    {:db/id :rest
                             :movement/name "Rest"}
      :exercise/application
      {:exercise.application/value
       {:exercise.application.value/all 60000.0}
       :exercise.application/unit  :unit/millisecond}}
     {:workout.loop/round-count 3
      :workout.loop/tasks
      [{:exercise/movement    {:db/id :double-db-clean-and-jerk
                               :movement/name "Double Dumbbell Clean & Jerk"}
        :exercise/application
        {:exercise.application/value
         {:exercise.application.value/men   20.0
          :exercise.application.value/women 15.0}
         :exercise.application/unit  :unit/kilogram}
        :exercise/rep-count   6}
       {:exercise/movement    {:db/id :handstand-walk
                               :movement/name "Handstand Walk"}
        :exercise/application
        {:exercise.application/value {:exercise.application.value/all 8.0}
         :exercise.application/unit  :unit/meter}
        :exercise/rep-count   6}]}
     {:exercise/movement    {:db/id :rest
                             :movement/name "Rest"}
      :exercise/application
      {:exercise.application/value
       {:exercise.application.value/all 60000.0}
       :exercise.application/unit  :unit/millisecond}}]}}}

