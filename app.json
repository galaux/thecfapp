{
  "name": "TheCFApp",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "APOLLO_INTROSPECTION": {
      "description": "Enable GraphQL introspection (required for Playground)",
      "value": "true"
    },
    "APOLLO_PLAYGROUND": {
      "description": "Enable Apollo Playground, the graphical GraphQL query editor",
      "value": "true"
    },
    "DATABASE_LOGGING": {
      "description": "Verbose ORM logging",
      "value": "true"
    },
    "REACT_APP_PUBLIC_API_URL": {
      "description": "URL of the public GraphQL API",
      "value": "https://${HEROKU_APP_NAME}.herokuapp.com"
    }
  },
  "environments": {
    "review": {
      "addons": ["heroku-postgresql:in-dyno"],
      "scripts": {
        "postdeploy": "yarn db:schema:sync && yarn db:seed:run"
      }
    }
  }
}
