{
  "name": "@thecfapp/api",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "yarn codegen && yarn tsc",
    "codegen": "yarn graphql-codegen",
    "db:schema:drop": "yarn typeorm schema:drop",
    "db:schema:log": "yarn typeorm schema:log",
    "db:schema:sync": "yarn typeorm schema:sync",
    "db:seed:config": "yarn typeorm-seeding config",
    "db:seed:run": "yarn typeorm-seeding seed",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "typeorm": "ts-node ../../node_modules/typeorm/cli.js",
    "typeorm-seeding": "ts-node ../../node_modules/typeorm-seeding/dist/cli.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "devDependencies": {
    "@graphql-codegen/cli": "1.19.2",
    "@graphql-codegen/introspection": "1.18.0",
    "@graphql-codegen/typescript": "1.17.11",
    "@graphql-codegen/typescript-resolvers": "1.17.11",
    "@types/graphql": "^14.5.0",
    "@types/jest": "^26.0.16",
    "@types/lodash": "^4.14.159",
    "@types/node": "^14.0.14",
    "@typescript-eslint/eslint-plugin": "^4.8.2",
    "@typescript-eslint/parser": "^4.8.2",
    "apollo-server-testing": "^2.16.1",
    "dotenv": "^8.2.0",
    "eslint": "^7.14.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-jest": "^24.1.3",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-sort-imports-es6-autofix": "^0.5.0",
    "husky": "^4.2.5",
    "jest": "26.6.0",
    "nodemon": "^2.0.4",
    "prettier": "^2.0.5",
    "pretty-quick": "^3.1.0",
    "sqlite3": "^5.0.0",
    "ts-jest": "^26.4.4",
    "ts-node": "^9.0.0",
    "typescript": "^4.1.2"
  },
  "dependencies": {
    "@js-joda/core": "^3.0.0",
    "@types/faker": "^5.1.4",
    "@types/uuid": "^8.3.0",
    "apollo-server": "^2.15.1",
    "apollo-server-express": "^2.16.0",
    "dataloader": "^2.0.0",
    "graphql": "^15.2.0",
    "graphql-joda-types": "^2.1.2",
    "graphql-voyager": "^1.0.0-rc.31",
    "lodash": "^4.17.19",
    "pg": "^8.2.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.2.25",
    "typeorm-seeding": "^1.6.1",
    "uuid": "^8.2.0"
  }
}
