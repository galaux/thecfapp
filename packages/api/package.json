{
  "name": "@thecfapp/api",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "yarn codegen && yarn tsc",
    "codegen": "yarn graphql-codegen",
    "db:schema": "ts-node ../../node_modules/typeorm/cli.js",
    "db:schema:drop": "yarn db:schema schema:drop",
    "db:schema:log": "yarn db:schema schema:log",
    "db:schema:sync": "yarn db:schema schema:sync",
    "db:seed": "ts-node ../../node_modules/typeorm-seeding/dist/cli.js",
    "db:seed:config": "yarn db:seed config",
    "db:seed:run": "yarn db:seed seed",
    "test": "jest"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "devDependencies": {
    "@graphql-codegen/cli": "1.16.1",
    "@graphql-codegen/introspection": "1.16.1",
    "@graphql-codegen/typescript": "1.16.1",
    "@graphql-codegen/typescript-resolvers": "1.16.1",
    "@types/graphql": "^14.5.0",
    "@types/jest": "^26.0.9",
    "@types/lodash": "^4.14.159",
    "@types/node": "^14.0.14",
    "@typescript-eslint/eslint-plugin": "^3.5.0",
    "@typescript-eslint/parser": "^3.5.0",
    "apollo-server-testing": "^2.16.1",
    "dotenv": "^8.2.0",
    "eslint": "^7.4.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-sort-imports-es6-autofix": "^0.5.0",
    "husky": "^4.2.5",
    "jest": "^26.2.2",
    "nodemon": "^2.0.4",
    "prettier": "^2.0.5",
    "pretty-quick": "^2.0.1",
    "sqlite3": "^5.0.0",
    "ts-jest": "^26.1.4",
    "ts-node": "^8.10.2",
    "typescript": "^3.9.7"
  },
  "dependencies": {
    "@js-joda/core": "^3.0.0",
    "@types/faker": "^5.1.4",
    "@types/uuid": "^8.3.0",
    "apollo-server": "^2.15.1",
    "apollo-server-express": "^2.16.0",
    "dataloader": "^2.0.0",
    "graphql": "^15.2.0",
    "graphql-joda-types": "^2.1.2",
    "graphql-voyager": "^1.0.0-rc.31",
    "lodash": "^4.17.19",
    "pg": "^8.2.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.2.25",
    "typeorm-seeding": "^1.6.1",
    "uuid": "^8.2.0"
  }
}
