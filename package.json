{
  "name": "thecfapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "yarn workspaces run build",
    "codegen": "yarn workspace @thecfapp/api run codegen",
    "db:schema:drop": "dotenv yarn workspace @thecfapp/api run db:schema:drop",
    "db:schema:log": "dotenv yarn workspace @thecfapp/api run db:schema:log",
    "db:schema:sync": "dotenv yarn workspace @thecfapp/api run db:schema:sync",
    "db:seed:config": "dotenv yarn workspace @thecfapp/api run db:seed:config",
    "db:seed:run": "dotenv yarn workspace @thecfapp/api run db:seed:run",
    "dev": "dotenv yarn workspace @thecfapp/server run dev",
    "start": "yarn workspace @thecfapp/server run start",
    "test": "yarn workspaces run test"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TheCFApp/thecfapp.git"
  },
  "contributors": [
    {
      "name": "Guillaume Alaux",
      "email": "guillaume@alaux.net"
    },
    {
      "name": "Ugo Onali",
      "email": "hello@onali-ugo.fr"
    }
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TheCFApp/thecfapp/issues"
  },
  "homepage": "https://github.com/TheCFApp/thecfapp#readme",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "12.x || 14.x"
  },
  "dependencies": {
    "dotenv-cli": "^4.0.0"
  }
}
