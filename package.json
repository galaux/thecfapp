{
  "name": "@thecfapp/mobile",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TheCFApp/thecfapp.git"
  },
  "scripts": {
    "ancient": "clojure -Sdeps '{:deps {com.github.liquidz/antq {:mvn/version \"RELEASE\"}}}' -m antq.core",
    "watch": "npx shadow-cljs watch mobile browser-test karma-test",
    "release": "npx shadow-cljs release mobile",
    "build-report": "npx shadow-cljs run shadow.cljs.build-report mobile target/build-report.html",
    "ci": "npx shadow-cljs compile karma-test && npx karma start --single-run --reporters junit,dots"
  },
  "dependencies": {
    "encoding": "^0.1.13",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "karma": "6.3.4",
    "karma-chrome-launcher": "3.1.0",
    "karma-cljs-test": "0.1.0",
    "karma-junit-reporter": "2.0.1",
    "shadow-cljs": "2.15.1"
  }
}
